use x86_encode

# These instructions are part of the generated image, not an external
# runtime object. The compiler feeds them to its own encoder.
unsafe fn cc_runtime(code: ptr<AsmObject>):
    let source: i64 = cv_text(".text\n_start:\nmov qword ptr [rip + VOLT_rt_initial_stack], rsp\nxor rbp, rbp\ncall VOLT_f_main\nmov rdi, rax\njmp VOLT_rt_exit\nVOLT_rt_argc:\nmov rax, qword ptr [rip + VOLT_rt_initial_stack]\nmov rax, qword ptr [rax]\nret\nVOLT_rt_argv:\nmov rax, qword ptr [rip + VOLT_rt_initial_stack]\nlea rax, [rax + 8]\nret\nVOLT_rt_envp:\nmov rax, qword ptr [rip + VOLT_rt_initial_stack]\nmov rcx, qword ptr [rax]\nlea rax, [rax + rcx*8 + 16]\nret\nVOLT_rt_exit:\nmov eax, 231\nsyscall\nud2\nVOLT_rt_write:\nmov eax, 1\nsyscall\nret\nVOLT_rt_write_all:\nmov r8, rsi\nmov r9, rdx\nmov r10, rdx\n.Lrt_write:\ntest r9, r9\njz .Lrt_done\nmov rsi, r8\nmov rdx, r9\nmov eax, 1\nsyscall\ncmp rax, -4\nje .Lrt_write\ntest rax, rax\njs .Lrt_return\njz .Lrt_zero\nadd r8, rax\nsub r9, rax\njmp .Lrt_write\n.Lrt_zero:\nmov rax, -5\n.Lrt_return:\nret\n.Lrt_done:\nmov rax, r10\nret\nVOLT_rt_read:\nxor eax, eax\nsyscall\nret\nVOLT_rt_open:\nmov eax, 2\nsyscall\nret\nVOLT_rt_close:\nmov eax, 3\nsyscall\nret\nVOLT_rt_mmap:\nmov rsi, rdi\nxor edi, edi\nmov edx, 3\nmov r10d, 0x22\nmov r8, -1\nxor r9d, r9d\nmov eax, 9\nsyscall\nret\nVOLT_rt_brk:\nmov eax, 12\nsyscall\nret\nVOLT_rt_strlen:\nxor eax, eax\ntest rdi, rdi\njz .Lrt_strlen_end\n.Lrt_strlen:\ncmp byte ptr [rdi+rax], 0\nje .Lrt_strlen_end\ninc rax\njmp .Lrt_strlen\n.Lrt_strlen_end:\nret\nVOLT_rt_munmap:\nmov eax, 11\nsyscall\nret\nVOLT_rt_panic:\nmov rsi, rdi\nxor edx, edx\ntest rsi, rsi\njz .Lrt_panic_write\n.Lrt_panic_scan:\ncmp byte ptr [rsi+rdx], 0\nje .Lrt_panic_write\ninc rdx\njmp .Lrt_panic_scan\n.Lrt_panic_write:\nmov edi, 2\nsub rsp, 8\ncall VOLT_rt_write_all\nadd rsp, 8\nmov edi, 1\njmp VOLT_rt_exit\n.section .bss\n.align 8\nVOLT_rt_initial_stack:\n.quad 0")
    let lines: i64 = cv_split(source, cv_text("\n"), 0)
    for i in 0..cv_len(lines): x_encode(code, cv_at(lines, i))
